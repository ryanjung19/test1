# Persistent NAS data root. Keep this outside the source checkout.
VASSMENT_DATA_ROOT=/volume1/docker/vassment-one
VASSMENT_SECRETS_ROOT=/volume1/docker/vassment-one/secrets

# LAN-only app exposure before Cloudflare Tunnel is attached.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3100
APP_URL=http://192.168.123.103:3100
DEFAULT_TIMEZONE=Asia/Seoul

# PostgreSQL non-secret identifiers. Password and DATABASE_URL live in protected files
# under VASSMENT_SECRETS_ROOT; see deploy/synology/README.md.
POSTGRES_USER=vassment
POSTGRES_DB=vassment_one_booking

# Keep false through development and Toss sandbox E2E. Changing it still requires
# the documented live-release approval and live keys in the protected secret files.
TOSS_LIVE_APPROVED=false
