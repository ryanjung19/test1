# Persistent NAS data root. Keep this outside the source checkout.
VASSMENT_DATA_ROOT=/volume1/docker/vassment-one

# LAN-only app exposure before Cloudflare Tunnel is attached.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3100
APP_URL=http://192.168.123.103:3100
DEFAULT_TIMEZONE=Asia/Seoul

# PostgreSQL.
# If /volume1/docker/vassment-one/postgres was already initialized, REUSE the exact
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB values used at that first initialization.
# Changing these environment variables does not change an existing PostgreSQL role password.
# For a new database, use a long URL-safe password so DATABASE_URL needs no percent-encoding.
POSTGRES_USER=vassment
POSTGRES_PASSWORD=CHANGE_TO_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=vassment_one_booking
DATABASE_URL=postgresql://vassment:CHANGE_TO_LONG_RANDOM_URL_SAFE_PASSWORD@postgres:5432/vassment_one_booking

# Initial single-admin authentication.
ADMIN_PASSWORD=CHANGE_TO_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_URL_SAFE_BYTES

# Customer reservation portal signing.
CUSTOMER_PORTAL_SECRET=CHANGE_TO_DIFFERENT_32_RANDOM_URL_SAFE_BYTES

# Existing chatbot / trusted backend integration.
INTEGRATION_WEBHOOK_SECRET=CHANGE_TO_RANDOM_INTEGRATION_SECRET

# HOLD expiry scheduler authentication.
AUTOMATION_SECRET=CHANGE_TO_RANDOM_AUTOMATION_SECRET

# Leave empty until Toss sandbox E2E starts. Never commit real values.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
