# Supabase browser-safe credentials
# Create a Supabase project in Seoul (ap-northeast-2) and copy these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application URL used for OAuth/email redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
EXPERT_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PORTONE_WEBHOOK_SECRET=
PORTONE_API_SECRET=
PORTONE_STORE_ID=
TOSS_SECRET_KEY=
