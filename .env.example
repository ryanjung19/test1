# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vassment_one_booking

# Application
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Seoul

# Initial single-admin login. Replace with account/RBAC auth when multiple operators are added.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Signed customer reservation-detail links
CUSTOMER_PORTAL_SECRET=replace-with-a-different-32-byte-random-secret

# Existing chatbot / trusted external channel integration
INTEGRATION_WEBHOOK_SECRET=replace-me

# Scheduled jobs such as HOLD expiration
AUTOMATION_SECRET=replace-me-too

# Payment provider (not wired in v0.1)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
